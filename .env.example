# ==============================================================================
# SmartSpend Master Environment Configuration Template
# Do not commit real production secrets to version control.
# ==============================================================================

# API Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# PostgreSQL Database (Local Docker or Managed Cloud instance)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/smartspend?schema=public"

# Authentication & Session Security (Minimum 32-character secrets)
JWT_ACCESS_SECRET="smartspend_jwt_access_super_secret_key_change_in_production_min32chars"
JWT_REFRESH_SECRET="smartspend_jwt_refresh_super_secret_key_change_in_production_min32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# AI Financial Copilot Provider ('gemini' | 'openai' | 'none')
# When AI_PROVIDER is 'none', SmartSpend operates with its deterministic financial rule engine.
AI_PROVIDER="none"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Mobile Expo Configuration
EXPO_PUBLIC_API_URL="http://localhost:4000/api/v1"
EXPO_PUBLIC_API_URL_ANDROID_EMULATOR="http://10.0.2.2:4000/api/v1"
