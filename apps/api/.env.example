# ==============================================================================
# SmartSpend Neo-Fintech Backend Environment Configuration
# ==============================================================================

# Server
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# PostgreSQL Database Connection
# Standard PostgreSQL URL format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Examples:
# - Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/smartspend?schema=public
# - Supabase / Neon Cloud: postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/smartspend?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartspend?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="smartspend_jwt_access_super_secret_key_change_in_production_min32chars"
JWT_REFRESH_SECRET="smartspend_jwt_refresh_super_secret_key_change_in_production_min32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# AI Provider Settings (Optional: 'gemini' | 'openai' | 'none')
AI_PROVIDER="none"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Security
BCRYPT_SALT_ROUNDS=12
