# Multi-stage Production Dockerfile for SmartSpend API
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/
COPY apps/api/prisma ./apps/api/prisma/

RUN npm install -g pnpm && pnpm install --frozen-lockfile=false

# Copy packages and API source
COPY packages/shared ./packages/shared/
COPY apps/api ./apps/api/

# Build shared package and API
RUN pnpm --filter @smartspend/shared build
RUN pnpm --filter @smartspend/api prisma:generate
RUN pnpm --filter @smartspend/api build

# Runner Stage
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/

RUN npm install -g pnpm && pnpm install --prod --frozen-lockfile=false

EXPOSE 4000

CMD ["node", "apps/api/dist/server.js"]
